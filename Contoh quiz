            {
                category: "AI - Reinforcement Learning",
                question: "Dalam Reinforcement Learning, komponen yang memberikan respons balik berupa hadiah/hukuman atas tindakan agen adalah...",
                options: ["Policy", "Environment", "State", "Reward Function"],
                answer: 3,
                explanation: "Reward Function menghitung skor positif (hadiah) atau negatif (hukuman) atas tindakan yang diambil oleh agen di dalam lingkungan."
            },
            {
                category: "AI - Ethics & Safety",
                question: "Proses penyesuaian model AI agar output yang dihasilkan aman, relevan, dan sesuai dengan nilai-nilai moral manusia disebut...",
                options: ["Fine-Tuning", "Alignment", "Pre-training", "Quantization"],
                answer: 1,
                explanation: "AI Alignment adalah bidang riset yang memastikan sistem AI bertindak sesuai dengan maksud, nilai, dan standar keselamatan manusia."
            }
        ];

        // App State
        let currentQuestionIndex = 0;
        let userAnswers = new Array(questionsData.length).fill(null);
        let timerInterval = null;
        let timeRemaining = 35 * 60; // 35 minutes in seconds

        // DOM Elements
        const welcomeScreen = document.getElementById('welcome-screen');
        const quizScreen = document.getElementById('quiz-screen');
        const resultScreen = document.getElementById('result-screen');
        const timerContainer = document.getElementById('timer-container');
        const timerDisplay = document.getElementById('timer-display');

        const startBtn = document.getElementById('start-btn');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        const finishBtn = document.getElementById('finish-btn');
        const restartBtn = document.getElementById('restart-btn');

        const questionCategory = document.getElementById('question-category');
        const questionText = document.getElementById('question-text');
        const optionsContainer = document.getElementById('options-container');
        const questionProgressText = document.getElementById('question-progress-text');
        const answeredCountText = document.getElementById('answered-count-text');
        const progressBar = document.getElementById('progress-bar');
        const gridNavigation = document.getElementById('grid-navigation');

        // Initialize App
        startBtn.addEventListener('click', startQuiz);
        prevBtn.addEventListener('click', goToPrevQuestion);
        nextBtn.addEventListener('click', goToNextQuestion);
        finishBtn.addEventListener('click', finishQuiz);
        restartBtn.addEventListener('click', restartQuiz);

        function startQuiz() {
            welcomeScreen.classList.add('hidden');
            quizScreen.classList.remove('hidden');
            timerContainer.classList.remove('hidden');
            timerContainer.classList.add('flex');

            buildGridNavigation();
            loadQuestion(0);
            startTimer();
        }

        function startTimer() {
            updateTimerDisplay();
            timerInterval = setInterval(() => {
                timeRemaining--;
                updateTimerDisplay();
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    finishQuiz();
                }
            }, 1000);
        }

        function updateTimerDisplay() {
            const minutes = Math.floor(timeRemaining / 60);
            const seconds = timeRemaining % 60;
            timerDisplay.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        function buildGridNavigation() {
            gridNavigation.innerHTML = '';
            for (let i = 0; i < questionsData.length; i++) {
                const btn = document.createElement('button');
                btn.className = `w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center border transition ${
                    i === 0 ? 'border-sky-500 bg-sky-500/20 text-sky-300' : 'border-slate-700 bg-slate-800 text-slate-400 hover:bg-slate-700'
                }`;
                btn.textContent = i + 1;
                btn.id = `grid-btn-${i}`;
                btn.addEventListener('click', () => loadQuestion(i));
                gridNavigation.appendChild(btn);
            }
        }

        function updateGridStatus() {
            for (let i = 0; i < questionsData.length; i++) {
                const btn = document.getElementById(`grid-btn-${i}`);
                if (!btn) continue;

                // Reset base classes
                let classes = "w-8 h-8 rounded-lg text-xs font-semibold flex items-center justify-center border transition ";

                if (i === currentQuestionIndex) {
                    classes += "ring-2 ring-sky-400 border-sky-500 ";
                }

                if (userAnswers[i] !== null) {
                    classes += "bg-sky-600 text-white border-sky-500";
                } else {
                    classes += "bg-slate-800 text-slate-400 border-slate-700 hover:bg-slate-700";
                }

                btn.className = classes;
            }
        }

        function loadQuestion(index) {
            currentQuestionIndex = index;
            const q = questionsData[index];

            questionCategory.textContent = q.category;
            
            // Format line breaks or code format if present
            questionText.innerHTML = q.question.replace(/\n/g, '<br>');

            // Options
            optionsContainer.innerHTML = '';
            q.options.forEach((opt, optIdx) => {
                const optionBtn = document.createElement('button');
                const isSelected = userAnswers[index] === optIdx;

                optionBtn.className = `w-full text-left p-4 rounded-xl border transition flex items-center space-x-3 ${
                    isSelected 
                    ? 'border-sky-500 bg-sky-500/10 text-sky-200 font-medium' 
                    : 'border-slate-700/80 bg-slate-900/50 hover:bg-slate-800 text-slate-300'
                }`;

                const letter = String.fromCharCode(65 + optIdx); // A, B, C, D
                optionBtn.innerHTML = `
                    <span class="w-7 h-7 rounded-lg flex items-center justify-center text-xs font-bold ${
                        isSelected ? 'bg-sky-500 text-white' : 'bg-slate-800 text-slate-400 border border-slate-700'
                    }">${letter}</span>
                    <span class="text-sm flex-grow">${opt}</span>
                `;

                optionBtn.addEventListener('click', () => selectOption(optIdx));
                optionsContainer.appendChild(optionBtn);
            });

            // Update Progress Header
            questionProgressText.textContent = `Soal ${index + 1} dari ${questionsData.length}`;
            const answeredCount = userAnswers.filter(a => a !== null).length;
            answeredCountText.textContent = `${answeredCount}/${questionsData.length} Terjawab`;
            progressBar.style.width = `${((index + 1) / questionsData.length) * 100}%`;

            // Update Buttons
            prevBtn.disabled = index === 0;
            if (index === questionsData.length - 1) {
                nextBtn.classList.add('hidden');
                finishBtn.classList.remove('hidden');
            } else {
                nextBtn.classList.remove('hidden');
                finishBtn.classList.add('hidden');
            }

            updateGridStatus();
        }

        function selectOption(optionIndex) {
            userAnswers[currentQuestionIndex] = optionIndex;
            loadQuestion(currentQuestionIndex);
        }

        function goToNextQuestion() {
            if (currentQuestionIndex < questionsData.length - 1) {
                loadQuestion(currentQuestionIndex + 1);
            }
        }

        function goToPrevQuestion() {
            if (currentQuestionIndex > 0) {
                loadQuestion(currentQuestionIndex - 1);
            }
        }

        function finishQuiz() {
            clearInterval(timerInterval);

            // Calculate Score
            let correctCount = 0;
            userAnswers.forEach((ans, idx) => {
                if (ans === questionsData[idx].answer) {
                    correctCount++;
                }
            });

            const total = questionsData.length;
            const percentage = Math.round((correctCount / total) * 100);
            const wrongCount = total - correctCount;

            const timeSpentSeconds = (35 * 60) - timeRemaining;
            const minutesSpent = Math.floor(timeSpentSeconds / 60);
            const secondsSpent = timeSpentSeconds % 60;
            const timeFormatted = `${minutesSpent}m ${secondsSpent}s`;

            // Display Results
            document.getElementById('final-score').textContent = `${percentage}%`;
            document.getElementById('correct-count').textContent = correctCount;
            document.getElementById('wrong-count').textContent = wrongCount;
            document.getElementById('time-taken').textContent = timeFormatted;

            // Trophy / Score Icon & Message
            const scoreIcon = document.getElementById('score-icon');
            const scoreMessage = document.getElementById('score-message');

            if (percentage >= 80) {
                scoreIcon.className = "fa-solid fa-trophy text-4xl text-amber-400";
                scoreMessage.textContent = "Luar biasa! Pemahaman koding dan AI Anda sangat tajam.";
            } else if (percentage >= 60) {
                scoreIcon.className = "fa-solid fa-medal text-4xl text-sky-400";
                scoreMessage.textContent = "Bagus! Anda memiliki fondasi yang cukup kuat.";
            } else {
                scoreIcon.className = "fa-solid fa-book-open text-4xl text-rose-400";
                scoreMessage.textContent = "Jangan berkecil hati! Pelajari pembahasan di bawah dan coba lagi.";
            }

            // Build Review Section
            buildReviewSection();

            // Toggle Screens
            quizScreen.classList.add('hidden');
            timerContainer.classList.add('hidden');
            resultScreen.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function buildReviewSection() {
            const reviewContainer = document.getElementById('review-container');
            reviewContainer.innerHTML = '';

            questionsData.forEach((q, idx) => {
                const userAns = userAnswers[idx];
                const isCorrect = userAns === q.answer;

                const item = document.createElement('div');
                item.className = `p-5 rounded-xl border bg-slate-900/60 ${
                    isCorrect ? 'border-emerald-500/30' : 'border-rose-500/30'
                }`;

                const userAnsText = userAns !== null ? q.options[userAns] : 'Tidak Dijawab';
                const correctAnsText = q.options[q.answer];

                item.innerHTML = `
                    <div class="flex items-start justify-between gap-4 mb-3">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Soal ${idx + 1} - ${q.category}</span>
                        <span class="px-2.5 py-1 rounded-full text-xs font-bold ${
                            isCorrect ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20'
                        }">
                            ${isCorrect ? '<i class="fa-solid fa-check mr-1"></i> Benar' : '<i class="fa-solid fa-xmark mr-1"></i> Salah'}
                        </span>
                    </div>
                    <p class="text-slate-200 font-medium text-sm md:text-base mb-4 leading-relaxed">${q.question.replace(/\n/g, '<br>')}</p>
                    
                    <div class="space-y-2 text-xs md:text-sm mb-4">
                        <div class="flex items-center text-slate-300">
                            <span class="w-32 font-semibold text-slate-400">Jawaban Anda:</span>
                            <span class="${isCorrect ? 'text-emerald-400 font-semibold' : 'text-rose-400 font-semibold'}">${userAnsText}</span>
                        </div>
                        ${!isCorrect ? `
                        <div class="flex items-center text-slate-300">
                            <span class="w-32 font-semibold text-slate-400">Jawaban Benar:</span>
                            <span class="text-emerald-400 font-semibold">${correctAnsText}</span>
                        </div>
                        ` : ''}
                    </div>

                    <div class="bg-slate-800/80 p-3 rounded-lg border border-slate-700/60 text-xs text-slate-300 leading-relaxed">
                        <strong class="text-sky-400 block mb-1"><i class="fa-solid fa-circle-info mr-1"></i> Pembahasan:</strong>
                        ${q.explanation}
                    </div>
                `;

                reviewContainer.appendChild(item);
            });
        }

        function restartQuiz() {
            userAnswers = new Array(questionsData.length).fill(null);
            timeRemaining = 35 * 60;
            currentQuestionIndex = 0;

            resultScreen.classList.add('hidden');
            welcomeScreen.classList.remove('hidden');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
</body>
</html>
